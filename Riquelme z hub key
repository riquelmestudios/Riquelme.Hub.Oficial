local function Tween(obj, props, t, style, dir)
    TweenService:Create(obj, TweenInfo.new(
        t     or 0.3,
        style or Enum.EasingStyle.Quart,
        dir   or Enum.EasingDirection.Out
    ), props):Play()
end

--[[
    Verifica a key no Firebase.
    Retorna: "valid" + tempoStr  |  "expired"  |  "invalid"  |  "error"  |  "empty"
    
    Estrutura esperada no Firebase:
    {
        "SUA-KEY": {
            "expireAt": 1700000000   <- Unix timestamp em SEGUNDOS (os.time())
        }
    }
]]
local function CheckKeyFirebase(keyInput)
    keyInput = keyInput:match("^%s*(.-)%s*$")
    if keyInput == "" then return "empty", "0" end

    local url = CONFIG.FirebaseURL .. keyInput .. ".json"

    local ok, response = pcall(function()
        return game:HttpGet(url, true)
    end)

    if not ok or not response then return "error", "0" end
    if response == "null" or response == "" then return "invalid", "0" end

    local parseOk, dados = pcall(function()
        return HttpService:JSONDecode(response)
    end)

    if not parseOk or type(dados) ~= "table" then return "invalid", "0" end
    if not dados.expireAt then return "invalid", "0" end

    local agora    = os.time()
    local expireAt = tonumber(dados.expireAt)

    if not expireAt or agora > expireAt then return "expired", "0" end

    -- Calcula tempo restante legível
    local restante = expireAt - agora
    local horas    = math.floor(restante / 3600)
    local minutos  = math.floor((restante % 3600) / 60)
    local tempoStr

    if horas >= 24 then
        local dias = math.floor(horas / 24)
        tempoStr = dias .. "d " .. (horas % 24) .. "h"
    elseif horas > 0 then
        tempoStr = horas .. "h " .. minutos .. "min"
    else
        tempoStr = minutos .. " minutos"
    end

    return "valid", tempoStr
end

