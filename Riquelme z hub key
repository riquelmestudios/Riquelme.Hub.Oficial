        LoadT.Size = UDim2.new(1, -20, 0, 18); LoadT.Position = UDim2.new(0, 10, 0, 174)
        LoadT.BackgroundTransparency = 1; LoadT.Text = "Carregando Riquelme Z Hub..."
        LoadT.Font = Enum.Font.Gotham; LoadT.TextColor3 = Color3.fromRGB(255, 210, 100); LoadT.TextSize = 12; LoadT.ZIndex = 12

        -- Barra de carregamento
        local LBG = Instance.new("Frame", SF)
        LBG.Size = UDim2.new(0.84, 0, 0, 8); LBG.Position = UDim2.new(0.08, 0, 0, 204)
        LBG.BackgroundColor3 = Color3.fromRGB(30, 20, 4); LBG.BorderSizePixel = 0; LBG.ZIndex = 12
        Instance.new("UICorner", LBG).CornerRadius = UDim.new(1, 0)
        local LFill = Instance.new("Frame", LBG)
        LFill.Size = UDim2.new(0, 0, 1, 0); LFill.BackgroundColor3 = T.Primary
        LFill.BorderSizePixel = 0; LFill.ZIndex = 13
        Instance.new("UICorner", LFill).CornerRadius = UDim.new(1, 0)
        -- Gradiente na barra
        local LGrad = Instance.new("UIGradient", LFill)
        LGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   Color3.fromRGB(255, 220, 60)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 150,  0)),
            ColorSequenceKeypoint.new(1,   Color3.fromRGB(220,  80,  0)),
        })
        Tween(LFill, {Size = UDim2.new(1, 0, 1, 0)}, 2.8, Enum.EasingStyle.Linear)

        -- Animação de dots
        local d = 0; local dc
        dc = RunService.Heartbeat:Connect(function()
            d = (d + 1) % 4
            if LoadT and LoadT.Parent then
                LoadT.Text = "Carregando Riquelme Z Hub" .. string.rep(".", d)
            else
                dc:Disconnect()
            end
        end)

        task.delay(3.2, function()
            if dc then dc:Disconnect() end
            Tween(SF,   {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}, 0.4)
            Tween(Film, {BackgroundTransparency = 1}, 0.4)
            Tween(BG,   {ImageTransparency = 1}, 0.4)

            task.delay(0.52, function()
                ScreenGui:Destroy()

                -- ══════════════════════════════════════
                --      EXECUTA O SCRIPT PRINCIPAL
                -- ══════════════════════════════════════
                local ok, content = pcall(function()
                    return game:HttpGet(CONFIG.MainScript, true)
                end)

                if ok and type(content) == "string" and #content > 0 then
                    local fn, err = loadstring(content)
                    if fn then
                        local ok2, runErr = pcall(fn)
                        if not ok2 then
                            warn("[RiquelmeZHub] Erro ao executar: " .. tostring(runErr))
                        end
                    else
                        warn("[RiquelmeZHub] Erro ao compilar: " .. tostring(err))
                    end
                else
                    warn("[RiquelmeZHub] Falha ao baixar script principal: " .. tostring(content))
                end
            end)
        end)
    end)
end

