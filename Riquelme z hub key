    NL.Font = Enum.Font.GothamBold; NL.TextColor3 = Color3.new(1, 1, 1)
    NL.TextSize = 13; NL.ZIndex = 31; NL.TextWrapped = true

    Tween(N, {Position = UDim2.new(0.5, -195, 0, 14)}, 0.42, Enum.EasingStyle.Back)
