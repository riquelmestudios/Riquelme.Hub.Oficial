-- ─── VERIFICAR KEY ───────────────────────────────────────────────────
local busy = false

local function DoVerify()
    if busy then return end
    local raw = KeyBox.Text

    if raw == "" then
        StatusLbl.TextColor3 = T.Warning
        StatusLbl.Text = "⚠  Campo vazio! Insira sua key de 10 horas."
        Tween(InputStroke, {Color = T.Warning}, 0.15)
        Notify("⚠  Insira sua key antes de verificar!", Color3.fromRGB(160, 110, 0), 2.5)
        task.delay(1.2, function() Tween(InputStroke, {Color = T.PrimaryDark}, 0.4) end)
        return
    end

    busy = true
    Tween(VerBtn, {BackgroundColor3 = Color3.fromRGB(120, 80, 0)}, 0.2)
    StatusLbl.TextColor3 = T.TextSub
    StatusLbl.Text = "Consultando Banco De Dados..."

    local d = 0; local dc
    dc = RunService.Heartbeat:Connect(function()
        d = (d + 1) % 4
        if VerBtn and VerBtn.Parent then
            VerBtn.Text = "Verificando" .. string.rep(".", d)
        end
    end)

    task.spawn(function()
        local result, info = CheckKeyFirebase(raw)
        dc:Disconnect()

        if result == "valid" then
            VerBtn.Text = "✓  Key Válida!"
            Tween(VerBtn,       {BackgroundColor3 = T.Success}, 0.2)
            Tween(InputStroke,  {Color = T.Success}, 0.2)
            StatusLbl.TextColor3 = T.Success
            StatusLbl.Text = "⚡  Key válida!  •  " .. info .. " restantes"
            Notify("⚡  Key Verificada!  🕐 " .. info .. " restantes", Color3.fromRGB(30, 140, 50), 3)
            task.delay(1.6, function() LaunchMain(info) end)

        elseif result == "expired" then
            busy = false
            VerBtn.Text = "Verificar Key"
            Tween(VerBtn,       {BackgroundColor3 = T.Primary}, 0.2)
            Tween(InputStroke,  {Color = T.Error}, 0.2)
            StatusLbl.TextColor3 = T.Error
            StatusLbl.Text = "✗  Key expirada! Obtenha uma nova."
            Notify("✗  Key expirada! Clique em OBTER KEY para uma nova.", Color3.fromRGB(150, 30, 0), 3.5)
            task.delay(1.3, function() Tween(InputStroke, {Color = T.PrimaryDark}, 0.4) end)

        elseif result == "error" then
            busy = false
            VerBtn.Text = "Verificar Key"
            Tween(VerBtn,       {BackgroundColor3 = T.Primary}, 0.2)
            Tween(InputStroke,  {Color = T.Warning}, 0.2)
            StatusLbl.TextColor3 = T.Warning
            StatusLbl.Text = "⚠  Erro de conexão! Verifique o executor."
            Notify("⚠  Erro ao conectar ao Banco De Dados. Tente novamente.", Color3.fromRGB(160, 110, 0), 3.5)
            task.delay(1.3, function() Tween(InputStroke, {Color = T.PrimaryDark}, 0.4) end)

        else -- invalid / empty
            busy = false
            VerBtn.Text = "Verificar Key"
            Tween(VerBtn,       {BackgroundColor3 = T.Primary}, 0.2)
            Tween(InputStroke,  {Color = T.Error}, 0.2)
            StatusLbl.TextColor3 = T.Error
            StatusLbl.Text = "✗  Key inválida! Verifique e tente novamente."
            Notify("✗  Key inválida! Obtenha uma key válida.", Color3.fromRGB(150, 30, 0), 3)

            -- Shake animation
            local base = -W / 2
            for i = 1, 6 do
                task.wait(0.045)
                local ox = (i % 2 == 0) and (base + 10) or (base - 10)
                Tween(Main, {Position = UDim2.new(0.5, ox, 0.5, -H/2)}, 0.045, Enum.EasingStyle.Linear)
            end
            task.delay(0.32, function()
                Tween(Main, {Position = UDim2.new(0.5, base, 0.5, -H/2)}, 0.1)
                Tween(InputStroke, {Color = T.PrimaryDark}, 0.4)
            end)
        end
    end)
end

